{
  "name": "nazorat-test",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "netlify dev --offline --no-open",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "check": "node scripts/check-structure.mjs",
    "build": "npm run check",
    "format": "prettier --write public server netlify/functions tests scripts",
    "postinstall": "node scripts/normalize-lock.mjs",
    "test:audit:api": "node scripts/audit-api.mjs",
    "test:audit:auth": "node scripts/audit-auth.mjs",
    "test:audit:browser": "node scripts/audit-browser.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "netlify-cli": "^27.16.1",
    "prettier": "^3.9.10"
  }
}
