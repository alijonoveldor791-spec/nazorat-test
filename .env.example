# Netlify: Environment variables orqali import qiling; scope Functions bo'lsin.
# Majburiy: quyidagi uchta kalit va bosh admin login-parolini to'ldiring.
# Kamida 32 belgili tasodifiy maxfiy kalit yozing; mavjud kalitni saqlang.
TOKEN_SECRET=
# Admin sessiyalari uchun TOKEN_SECRET'dan alohida, kamida 32 belgili kalit.
ADMIN_SESSION_SECRET=
# Ixtiyoriy: kalit almashishida oldingi admin tokenlar uchun; yangi saytda bo'sh.
ADMIN_SESSION_PREVIOUS_SECRET=
# Test kodlarini shifrlash uchun alohida, kamida 32 belgili kalit.
TEST_CODE_ENCRYPTION_KEY=
# Ixtiyoriy: qayta shifrlash tugaguncha oldingi kalit; yangi saytda bo'sh.
TEST_CODE_ENCRYPTION_KEY_PREVIOUS=
# Bosh admin bootstrap login-paroli; mavjud hisob parolini avtomatik almashtirmaydi.
SUPER_ADMIN_LOGIN=
SUPER_ADMIN_PASSWORD=

# Ixtiyoriy: eski binar .doc faylni DOCX qaytaradigan HTTPS xizmatiga yuboradi.
DOC_CONVERTER_URL=
DOC_CONVERTER_TOKEN=
# Ixtiyoriy: DOCX ichidagi MathType/OLE obyektini asl formulani saqlagan OMMLga aylantiradi.
DOC_MATH_CONVERTER_URL=
DOC_MATH_CONVERTER_TOKEN=
